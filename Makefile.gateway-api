GENERATOR ?= ./scripts/generate_gateway_api.sh
HELM_RELEASE ?= harness
HELM_NAMESPACE ?= harness

# Supply complete Helm-style argument chains when invoking make, for example:
# make gateway-api-ut UT_VALUES='-f values-base.yaml -f values-ut.yaml'
UT_VALUES ?=
PROD_VALUES ?=

.PHONY: gateway-api-ut gateway-api-prod gateway-api-check-ut gateway-api-check-prod

gateway-api-ut:
	@test -n "$(UT_VALUES)" || { echo "Set UT_VALUES to the ordered -f/--values arguments" >&2; exit 1; }
	$(GENERATOR) ut --release "$(HELM_RELEASE)" --namespace "$(HELM_NAMESPACE)" $(UT_VALUES)

gateway-api-prod:
	@test -n "$(PROD_VALUES)" || { echo "Set PROD_VALUES to the ordered -f/--values arguments" >&2; exit 1; }
	$(GENERATOR) prod --release "$(HELM_RELEASE)" --namespace "$(HELM_NAMESPACE)" $(PROD_VALUES)

gateway-api-check-ut:
	@test -n "$(UT_VALUES)" || { echo "Set UT_VALUES to the ordered -f/--values arguments" >&2; exit 1; }
	$(GENERATOR) ut --release "$(HELM_RELEASE)" --namespace "$(HELM_NAMESPACE)" $(UT_VALUES) --check

gateway-api-check-prod:
	@test -n "$(PROD_VALUES)" || { echo "Set PROD_VALUES to the ordered -f/--values arguments" >&2; exit 1; }
	$(GENERATOR) prod --release "$(HELM_RELEASE)" --namespace "$(HELM_NAMESPACE)" $(PROD_VALUES) --check
