#!/usr/bin/env bash
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)

if [[ -n "${HARNESS_PLATFORM_CHART:-}" ]]; then
  exec bash "$ROOT/tests/render_contract_test.sh"
fi

TEST_PLATFORM_TMP=$(mktemp -d "${TMPDIR:-/tmp}/harness-platform-test.XXXXXX")
trap 'rm -rf -- "$TEST_PLATFORM_TMP"' EXIT HUP INT TERM

"$SCRIPT_DIR/fetch-platform-chart" "$TEST_PLATFORM_TMP/platform"
HARNESS_PLATFORM_CHART="$TEST_PLATFORM_TMP/platform" \
  bash "$ROOT/tests/render_contract_test.sh"
