#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
CONVERTER_CHART="$SCRIPT_DIR/ingress-converter"

usage() {
  cat <<'EOF'
Usage:
  generate-gateway-api \
    --harness-chart LOCAL_PATH \
    --custom-chart DIRECTORY \
    --output-chart DIRECTORY \
    --namespace NAMESPACE \
    --kube-version VERSION \
    [--release-name NAME] \
    [--allow-implementation-specific-regex-ordering] \
    [--api-versions VERSION]... \
    [-f|--values FILE]...

Render Harness with its native Gateway API support disabled, derive a routing
inventory from the emitted Ingress and Service resources, and place that
inventory in an environment-specific copy of the custom chart.

The output directory must not already exist. Values files are passed to the
Harness render in the order supplied. --kube-version is required so rendering
does not silently change with Helm's built-in Kubernetes version. By default,
conversion fails if regex matches have ordering that cannot be preserved by
Gateway API; the explicit acknowledgement flag permits that known migration
risk and records it in the generated inventory.
EOF
}

fail() {
  printf 'generate-gateway-api: %s\n' "$*" >&2
  exit 1
}

require_value() {
  local option=$1
  local value=${2:-}
  [[ -n "$value" ]] || fail "$option requires a value"
}

extract_prefixed_line() {
  local prefix=$1
  local input=$2
  local output=$3

  awk -v wanted="$prefix" '
    index($0, wanted) == 1 {
      print substr($0, length(wanted) + 1)
      count++
    }
    END {
      if (count != 1) {
        exit 1
      }
    }
  ' "$input" >"$output"
}

resolve_future_path() {
  local requested=$1
  local current
  local existing_base
  local leaf
  local suffix=''

  case "/$requested/" in
    *'/../'*) fail "output path must not contain .. components: $requested" ;;
  esac
  if [[ "$requested" = /* ]]; then
    current=$requested
  else
    current="$(pwd -P)/$requested"
  fi
  while [[ ! -e "$current" ]]; do
    leaf=${current##*/}
    [[ -n "$leaf" ]] || fail "cannot resolve output path: $requested"
    suffix="/$leaf$suffix"
    current=${current%/*}
    [[ -n "$current" ]] || current='/'
  done
  [[ -d "$current" ]] || fail "output path ancestor is not a directory: $current"
  existing_base=$(CDPATH='' cd -- "$current" && pwd -P)
  printf '%s%s\n' "$existing_base" "$suffix"
}

harness_chart=''
custom_chart=''
output_chart=''
namespace=''
release_name='harness'
harness_value_args=()
kube_version=''
api_version_args=()
allow_implementation_specific_regex_ordering=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --harness-chart)
      require_value "$1" "${2:-}"
      harness_chart=$2
      shift 2
      ;;
    --custom-chart)
      require_value "$1" "${2:-}"
      custom_chart=$2
      shift 2
      ;;
    --output-chart)
      require_value "$1" "${2:-}"
      output_chart=$2
      shift 2
      ;;
    --namespace)
      require_value "$1" "${2:-}"
      namespace=$2
      shift 2
      ;;
    --release-name)
      require_value "$1" "${2:-}"
      release_name=$2
      shift 2
      ;;
    --kube-version)
      require_value "$1" "${2:-}"
      kube_version=$2
      shift 2
      ;;
    --api-versions)
      require_value "$1" "${2:-}"
      api_version_args+=(--api-versions "$2")
      shift 2
      ;;
    --allow-implementation-specific-regex-ordering)
      allow_implementation_specific_regex_ordering=true
      shift
      ;;
    -f|--values)
      require_value "$1" "${2:-}"
      [[ -f "$2" ]] || fail "values file does not exist: $2"
      harness_value_args+=(--values "$2")
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      [[ $# -eq 0 ]] || fail "unexpected positional arguments: $*"
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
done

[[ -n "$harness_chart" ]] || fail '--harness-chart is required'
[[ -n "$custom_chart" ]] || fail '--custom-chart is required'
[[ -n "$output_chart" ]] || fail '--output-chart is required'
[[ -n "$namespace" ]] || fail '--namespace is required'
[[ -n "$release_name" ]] || fail '--release-name must not be empty'
[[ -n "$kube_version" ]] || fail '--kube-version is required'
while [[ "$output_chart" != '/' && "$output_chart" == */ ]]; do
  output_chart=${output_chart%/}
done
[[ -d "$harness_chart" || -f "$harness_chart" ]] || \
  fail "Harness chart must be a local directory or archive: $harness_chart"
[[ -d "$custom_chart" ]] || fail "custom chart is not a directory: $custom_chart"
[[ -f "$custom_chart/Chart.yaml" ]] || fail "custom chart has no Chart.yaml: $custom_chart"
[[ -d "$CONVERTER_CHART" ]] || fail "internal converter chart is missing: $CONVERTER_CHART"
[[ ! -e "$output_chart" ]] || fail "output path already exists: $output_chart"
[[ "$output_chart" != '/' && "$output_chart" != '.' ]] || fail 'refusing unsafe output path'

custom_chart_canonical=$(CDPATH='' cd -- "$custom_chart" && pwd -P)
output_chart_canonical=$(resolve_future_path "$output_chart")
case "$output_chart_canonical/" in
  "$custom_chart_canonical/"*)
    fail 'output path must be outside the source custom chart'
    ;;
esac
if [[ -d "$harness_chart" ]]; then
  harness_chart_canonical=$(CDPATH='' cd -- "$harness_chart" && pwd -P)
  case "$output_chart_canonical/" in
    "$harness_chart_canonical/"*)
      fail 'output path must be outside the source Harness chart'
      ;;
  esac
fi

command -v helm >/dev/null 2>&1 || fail 'helm is required'
command -v awk >/dev/null 2>&1 || fail 'awk is required'
command -v tar >/dev/null 2>&1 || fail 'tar is required'

helm_version=$(helm version --template '{{ .Version }}')
[[ -n "$helm_version" ]] || fail 'helm version could not be determined'

umask 077
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/harness-gateway-generator.XXXXXX")
cleanup() {
  rm -rf -- "$work_dir"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

rendered_manifest="$work_dir/harness-render.yaml"
converter_output="$work_dir/converter-output.yaml"
inventory_file="$work_dir/harness-gateway-inventory.json"
package_dir="$work_dir/package"
validation_package_dir="$work_dir/validation-package"
unpack_dir="$work_dir/unpack"
mkdir -p "$package_dir" "$validation_package_dir" "$unpack_dir"

# This final override is deliberately placed after all environment values.
# It prevents Harness helpers from rendering native Gateway API resources.
render_args=(--namespace "$namespace" --no-hooks)
if [[ ${#harness_value_args[@]} -gt 0 ]]; then
  render_args+=("${harness_value_args[@]}")
fi
render_args+=(--kube-version "$kube_version")
if [[ ${#api_version_args[@]} -gt 0 ]]; then
  render_args+=("${api_version_args[@]}")
fi
render_args+=(--set global.gatewayAPI.enabled=false)
helm template "$release_name" "$harness_chart" \
  "${render_args[@]}" >"$rendered_manifest"

converter_args=(
  --namespace "$namespace"
  --set-file sourceManifest="$rendered_manifest"
  --set-string sourceReleaseName="$release_name"
  --set-string sourceNamespace="$namespace"
  --set-string sourceKubeVersion="$kube_version"
  --set-string sourceHelmVersion="$helm_version"
  --set allowImplementationSpecificRegexOrdering="$allow_implementation_specific_regex_ordering"
)
api_version_index=0
while [[ "$api_version_index" -lt "${#api_version_args[@]}" ]]; do
  converter_args+=(
    --set-string "sourceApiVersions[$((api_version_index / 2))]=${api_version_args[api_version_index + 1]}"
  )
  api_version_index=$((api_version_index + 2))
done
helm template harness-ingress-converter "$CONVERTER_CHART" \
  "${converter_args[@]}" >"$converter_output"

extract_prefixed_line \
  $'#HARNESS_GATEWAY_INVENTORY\t' \
  "$converter_output" \
  "$inventory_file" || fail 'converter did not emit exactly one routing inventory'

awk '
  index($0, "#HARNESS_GATEWAY_WARNING\t") == 1 {
    sub(/^#HARNESS_GATEWAY_WARNING\t/, "")
    print "generate-gateway-api: warning: " $0 > "/dev/stderr"
  }
' "$converter_output"

helm package "$custom_chart" --destination "$package_dir" >/dev/null
chart_archive=$(find "$package_dir" -maxdepth 1 -type f -name '*.tgz' -print -quit)
[[ -n "$chart_archive" ]] || fail 'helm package did not create a chart archive'

if tar -tzf "$chart_archive" | awk '
  $0 ~ /(^|\/)\.\.($|\/)/ || $0 ~ /^\// { invalid=1 }
  END { exit invalid ? 0 : 1 }
'; then
  fail 'packaged custom chart contains an unsafe archive path'
fi

tar -xzf "$chart_archive" -C "$unpack_dir"
generated_chart=$(find "$unpack_dir" -mindepth 1 -maxdepth 1 -type d -print -quit)
[[ -n "$generated_chart" ]] || fail 'packaged custom chart has no chart directory'

mkdir -p "$generated_chart/generated"
cp "$inventory_file" "$generated_chart/generated/harness-gateway-inventory.json"

# Package the completed chart once more before publishing it. Helm applies the
# destination chart's .helmignore while loading it, so this catches an ignored
# inventory now instead of producing a chart that fails only when later used.
helm package "$generated_chart" --destination "$validation_package_dir" >/dev/null
validation_chart_archive=$(find "$validation_package_dir" -maxdepth 1 -type f -name '*.tgz' -print -quit)
[[ -n "$validation_chart_archive" ]] || fail 'helm package did not create a validation chart archive'
expected_inventory_member="${generated_chart##*/}/generated/harness-gateway-inventory.json"
if ! tar -tzf "$validation_chart_archive" | awk -v wanted="$expected_inventory_member" '
  $0 == wanted { found=1 }
  END { exit found ? 0 : 1 }
'; then
  fail 'generated/harness-gateway-inventory.json is excluded from the output chart; update the custom chart .helmignore so Helm includes this file'
fi

output_parent=$(dirname -- "$output_chart")
mkdir -p "$output_parent"
mv "$generated_chart" "$output_chart"

summary=$(awk '
  index($0, "#HARNESS_GATEWAY_SUMMARY\t") == 1 {
    sub(/^#HARNESS_GATEWAY_SUMMARY\t/, "")
    print
    exit
  }
' "$converter_output")

printf 'Generated chart: %s\n' "$output_chart"
if [[ -n "$summary" ]]; then
  printf 'Routing inventory: %s\n' "$summary"
fi
