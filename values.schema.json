{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "harnessGatewayOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ciliumNetworkPolicy"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Render generated Gateway API resources and their stable supporting resources."
        },
        "ciliumNetworkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render the additive Envoy-to-Harness Cilium allow rule."
            }
          }
        }
      }
    }
  },
  "required": ["harnessGatewayOverlay"],
  "additionalProperties": true
}
